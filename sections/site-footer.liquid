{% if section.settings.show_plane %}
<div class="wii-runway-scene" aria-hidden="true">
  <div class="wii-scene-tile">
    <svg viewBox="0 0 1200 330" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMax slice">
      <defs>
        <linearGradient id="pl-skybg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#6fbceb"/><stop offset="1" stop-color="#d6eefc"/>
        </linearGradient>
        <linearGradient id="pl-ocean" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#14568a"/><stop offset="1" stop-color="#2b83bd"/>
        </linearGradient>
      </defs>
      <rect x="0" y="0" width="1200" height="306" fill="url(#pl-skybg)"/>

      <!-- Memphis pyramid: powder-blue faces matching the arch -->
      <g stroke-linejoin="round">
        <polygon points="975,168 878,306 998,306" fill="#b8cfdf" stroke="#7e9cb2" stroke-width="3"/>
        <polygon points="975,168 998,306 1072,306" fill="#8fb0c6" stroke="#7e9cb2" stroke-width="3"/>
        <g stroke="#ffffff" stroke-width="1.4" opacity=".35">
          <line x1="936" y1="224" x2="1023" y2="224"/>
          <line x1="916" y1="252" x2="1044" y2="252"/>
          <line x1="897" y1="280" x2="1061" y2="280"/>
        </g>
        <line x1="975" y1="168" x2="998" y2="306" stroke="#7e9cb2" stroke-width="2.5"/>
      </g>

      <!-- Gateway arch (image), left leg overlapping the pyramid -->
      <image href="{{ 'arch.webp' | asset_url }}" x="1002" y="128" width="163" height="178" preserveAspectRatio="xMidYMax meet"/>

      <rect x="0" y="298" width="1200" height="8" fill="#cfe6f4"/>
      <rect x="0" y="304" width="1200" height="26" fill="url(#pl-ocean)"/>
      <g class="wii-plane-g">
        <image href="{{ 'airplane.webp' | asset_url }}" x="300" y="72" width="540" height="172" preserveAspectRatio="xMidYMid meet"/>
      </g>
    </svg>
  </div>
</div>
{% endif %}

<footer class="footer">
  <div class="legal">
    {% if section.settings.show_notice %}
      <h4>{{ section.settings.notice_heading }}</h4>
      <div>{{ section.settings.notice_body }}</div>
      {% if section.blocks.size > 0 %}
        <ul>
          {% for block in section.blocks %}
            {% if block.settings.label != blank and block.settings.url != blank %}
              <li {{ block.shopify_attributes }}><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    {% endif %}
    <p>&copy; <span id="year"></span> {{ shop.name }}. {{ section.settings.copyright_suffix }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_plane", "label": "Show airplane and runway above footer", "default": true },
    { "type": "checkbox", "id": "show_notice", "label": "Show legal notice", "default": true },
    { "type": "text", "id": "notice_heading", "label": "Notice heading", "default": "Research Chemicals — Notice" },
    {
      "type": "richtext",
      "id": "notice_body",
      "label": "Notice body",
      "default": "<p>Products in the \"Research Chemicals\" category are supplied strictly for <strong>laboratory research use only</strong>. Not for human consumption, veterinary use, medical use, diagnostic use, or household use. Age verification and compliance checks may be required. Provide and review Safety Data Sheets (SDS) prior to handling.</p>"
    },
    { "type": "text", "id": "copyright_suffix", "label": "Copyright suffix", "default": "All rights reserved." }
  ],
  "blocks": [
    {
      "type": "footer_link",
      "name": "Footer link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "SDS: Document" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ]
}
{% endschema %}
