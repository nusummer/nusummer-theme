{% if section.settings.show_wii_bar %}
  <div class="wii-bottom-bar" aria-hidden="true">
    <div class="wii-bar-button left"></div>
    <div class="wii-bar-button right"></div>
  </div>
{% endif %}

<footer class="footer">
  <div class="legal">
    {% if section.settings.show_notice %}
      <h4>{{ section.settings.notice_heading }}</h4>
      <div>{{ section.settings.notice_body }}</div>
      {% if section.blocks.size > 0 %}
        <ul>
          {% for block in section.blocks %}
            {% if block.settings.label != blank and block.settings.url != blank %}
              <li {{ block.shopify_attributes }}><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    {% endif %}
    <p>&copy; <span id="year"></span> {{ shop.name }}. {{ section.settings.copyright_suffix }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_wii_bar", "label": "Show curved bottom bar", "default": true },
    { "type": "checkbox", "id": "show_notice", "label": "Show legal notice", "default": true },
    { "type": "text", "id": "notice_heading", "label": "Notice heading", "default": "Research Chemicals — Notice" },
    {
      "type": "richtext",
      "id": "notice_body",
      "label": "Notice body",
      "default": "<p>Products in the \"Research Chemicals\" category are supplied strictly for <strong>laboratory research use only</strong>. Not for human consumption, veterinary use, medical use, diagnostic use, or household use. Age verification and compliance checks may be required. Provide and review Safety Data Sheets (SDS) prior to handling.</p>"
    },
    { "type": "text", "id": "copyright_suffix", "label": "Copyright suffix", "default": "All rights reserved." }
  ],
  "blocks": [
    {
      "type": "footer_link",
      "name": "Footer link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "SDS: Document" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ]
}
{% endschema %}
