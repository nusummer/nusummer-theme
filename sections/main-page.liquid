<section
  class="panel section-wrap"
  style="
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    max-width: {{ section.settings.content_max_width }}px;
    margin-left: auto;
    margin-right: auto;
  "
>
  {% if section.settings.show_title %}
    <h1 style="color: {{ section.settings.heading_color }}; font-size: {{ section.settings.heading_size }}px;">
      {{ section.settings.page_heading | default: page.title }}
    </h1>
  {% endif %}

  {% if section.settings.intro_text != blank %}
    <p class="page-intro rte" style="color: {{ section.settings.text_color }}; font-size: {{ section.settings.intro_size }}px;">
      {{ section.settings.intro_text }}
    </p>
  {% endif %}

  {% for block in section.blocks %}
    {% case block.type %}

      {% when 'heading' %}
        <h2
          class="page-block-heading"
          style="color: {{ block.settings.heading_color }}; font-size: {{ block.settings.heading_size }}px; margin-top: {{ block.settings.spacing_top }}px;"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.heading }}
        </h2>

      {% when 'text' %}
        <div
          class="rte page-block-text"
          style="color: {{ block.settings.text_color }}; font-size: {{ block.settings.text_size }}px; margin-top: {{ block.settings.spacing_top }}px;"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.content }}
        </div>

      {% when 'image' %}
        {% if block.settings.image != blank %}
          <div
            class="page-block-image"
            style="text-align: {{ block.settings.image_align }}; margin-top: {{ block.settings.spacing_top }}px;"
            {{ block.shopify_attributes }}
          >
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image_alt | escape }}"
              loading="lazy"
              style="
                width: 100%;
                max-width: {{ block.settings.max_width }}px;
                border-radius: {{ block.settings.border_radius }}px;
              "
            >
            {% if block.settings.caption != blank %}
              <p class="page-block-caption" style="color: {{ block.settings.caption_color }}; font-size: 13px; margin-top: 6px;">
                {{ block.settings.caption }}
              </p>
            {% endif %}
          </div>
        {% endif %}

      {% when 'button' %}
        <div
          class="page-block-button"
          style="margin-top: {{ block.settings.spacing_top }}px; text-align: {{ block.settings.button_align }};"
          {{ block.shopify_attributes }}
        >
          <a
            href="{{ block.settings.button_url }}"
            class="btn"
            style="background: {{ block.settings.btn_bg_color }}; color: {{ block.settings.btn_text_color }};"
          >
            {{ block.settings.button_label }}
          </a>
        </div>

      {% when 'divider' %}
        <hr
          style="
            border: none;
            border-top: {{ block.settings.thickness }}px solid {{ block.settings.color }};
            margin: {{ block.settings.spacing }}px 0;
          "
          {{ block.shopify_attributes }}
        >

      {% when 'spacer' %}
        <div style="height: {{ block.settings.height }}px;" {{ block.shopify_attributes }}></div>

      {% when 'hero' %}
        <div
          class="page-block-hero"
          style="
            position: relative;
            min-height: {{ block.settings.min_height }}px;
            display: flex;
            align-items: {{ block.settings.vertical_align }};
            justify-content: {{ block.settings.horizontal_align }};
            text-align: {{ block.settings.text_align }};
            border-radius: {{ block.settings.border_radius }}px;
            overflow: hidden;
            margin-top: {{ block.settings.spacing_top }}px;
            background-color: {{ block.settings.bg_color }};
            {% if block.settings.bg_image != blank %}
              background-image: url('{{ block.settings.bg_image | image_url: width: 1600 }}');
              background-size: cover;
              background-position: center;
            {% endif %}
          "
          {{ block.shopify_attributes }}
        >
          {% if block.settings.overlay_opacity > 0 %}
            <div style="
              position: absolute; inset: 0;
              background: {{ block.settings.overlay_color }};
              opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
              pointer-events: none;
            "></div>
          {% endif %}
          <div style="position: relative; z-index: 1; padding: {{ block.settings.inner_padding }}px; max-width: {{ block.settings.content_max_width }}px;">
            {% if block.settings.eyebrow != blank %}
              <p style="margin: 0 0 8px; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: {{ block.settings.text_color }}; opacity: .8;">
                {{ block.settings.eyebrow }}
              </p>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h2 style="margin: 0 0 12px; font-size: {{ block.settings.heading_size }}px; color: {{ block.settings.text_color }}; line-height: 1.2;">
                {{ block.settings.heading }}
              </h2>
            {% endif %}
            {% if block.settings.subtext != blank %}
              <p style="margin: 0 0 20px; color: {{ block.settings.text_color }}; opacity: .85; font-size: {{ block.settings.subtext_size }}px;">
                {{ block.settings.subtext }}
              </p>
            {% endif %}
            {% if block.settings.btn_label != blank %}
              <a
                href="{{ block.settings.btn_url }}"
                class="btn"
                style="background: {{ block.settings.btn_bg }}; color: {{ block.settings.btn_text }}; border-color: {{ block.settings.btn_bg }};"
              >
                {{ block.settings.btn_label }}
              </a>
            {% endif %}
            {% if block.settings.btn2_label != blank %}
              <a
                href="{{ block.settings.btn2_url }}"
                class="btn secondary"
                style="margin-left: 8px; background: transparent; color: {{ block.settings.text_color }}; border-color: {{ block.settings.text_color }};"
              >
                {{ block.settings.btn2_label }}
              </a>
            {% endif %}
          </div>
        </div>

      {% when 'two_column' %}
        <div
          class="page-block-two-col"
          style="
            display: grid;
            grid-template-columns: {{ block.settings.col1_width }}% 1fr;
            gap: {{ block.settings.gap }}px;
            align-items: {{ block.settings.vertical_align }};
            margin-top: {{ block.settings.spacing_top }}px;
          "
          {{ block.shopify_attributes }}
        >
          <div style="color: {{ block.settings.col1_text_color }}; font-size: {{ block.settings.text_size }}px;">
            {% if block.settings.col1_heading != blank %}
              <h3 style="margin: 0 0 10px; color: {{ block.settings.col1_text_color }};">{{ block.settings.col1_heading }}</h3>
            {% endif %}
            {% if block.settings.col1_image != blank %}
              <img src="{{ block.settings.col1_image | image_url: width: 800 }}" alt="" loading="lazy" style="width: 100%; border-radius: {{ block.settings.image_radius }}px; margin-bottom: 12px;">
            {% endif %}
            <div class="rte">{{ block.settings.col1_content }}</div>
          </div>
          <div style="color: {{ block.settings.col2_text_color }}; font-size: {{ block.settings.text_size }}px;">
            {% if block.settings.col2_heading != blank %}
              <h3 style="margin: 0 0 10px; color: {{ block.settings.col2_text_color }};">{{ block.settings.col2_heading }}</h3>
            {% endif %}
            {% if block.settings.col2_image != blank %}
              <img src="{{ block.settings.col2_image | image_url: width: 800 }}" alt="" loading="lazy" style="width: 100%; border-radius: {{ block.settings.image_radius }}px; margin-bottom: 12px;">
            {% endif %}
            <div class="rte">{{ block.settings.col2_content }}</div>
          </div>
        </div>

      {% when 'video' %}
        <div
          class="page-block-video"
          style="margin-top: {{ block.settings.spacing_top }}px; max-width: {{ block.settings.max_width }}px; margin-left: auto; margin-right: auto;"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.video_title != blank %}
            <h3 style="margin: 0 0 10px; color: {{ section.settings.text_color }};">{{ block.settings.video_title }}</h3>
          {% endif %}
          {% if block.settings.video_url != blank %}
            {% assign video_url = block.settings.video_url %}
            {% if video_url contains 'youtube.com/watch?v=' %}
              {% assign video_id = video_url | split: 'v=' | last | split: '&' | first %}
              {% assign embed_url = 'https://www.youtube.com/embed/' | append: video_id %}
            {% elsif video_url contains 'youtu.be/' %}
              {% assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first %}
              {% assign embed_url = 'https://www.youtube.com/embed/' | append: video_id %}
            {% elsif video_url contains 'vimeo.com/' %}
              {% assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first %}
              {% assign embed_url = 'https://player.vimeo.com/video/' | append: video_id %}
            {% else %}
              {% assign embed_url = video_url %}
            {% endif %}
            <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: {{ block.settings.border_radius }}px;">
              <iframe
                src="{{ embed_url }}"
                style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
          {% else %}
            <p style="color: var(--muted); font-style: italic;">Paste a YouTube or Vimeo URL in the Video URL setting to embed a video here.</p>
          {% endif %}
          {% if block.settings.caption != blank %}
            <p style="color: var(--muted); font-size: 13px; margin-top: 8px;">{{ block.settings.caption }}</p>
          {% endif %}
        </div>

      {% when 'product_feature' %}
        {% assign fp = all_products[block.settings.product] %}
        {% if fp != blank %}
          <div
            class="page-block-product-feature"
            style="
              display: grid;
              grid-template-columns: {% if block.settings.image_side == 'right' %}1fr {{ block.settings.image_width }}%{% else %}{{ block.settings.image_width }}% 1fr{% endif %};
              gap: {{ block.settings.gap }}px;
              align-items: center;
              margin-top: {{ block.settings.spacing_top }}px;
              background: {{ block.settings.bg_color }};
              border-radius: {{ block.settings.border_radius }}px;
              padding: {{ block.settings.inner_padding }}px;
            "
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image_side == 'right' %}
              <div>
                {% if block.settings.eyebrow != blank %}
                  <p style="margin: 0 0 6px; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: var(--muted);">{{ block.settings.eyebrow }}</p>
                {% endif %}
                <h2 style="margin: 0 0 8px; color: {{ block.settings.text_color }}; font-size: {{ block.settings.heading_size }}px;">{{ fp.title }}</h2>
                <p style="color: var(--price); font-weight: 700; font-size: 18px; margin: 0 0 12px;">{{ fp.price | money }}</p>
                {% if block.settings.show_description %}
                  <div style="color: {{ block.settings.text_color }}; margin-bottom: 16px;">{{ fp.description | strip_html | truncate: 200 }}</div>
                {% endif %}
                {% form 'product', fp %}
                  <input type="hidden" name="id" value="{{ fp.selected_or_first_available_variant.id }}">
                  <button class="btn" type="submit">{{ block.settings.btn_label }}</button>
                  {% if block.settings.show_shop_pay %}
                    <div style="margin-top: 10px;">
                      {{ form | payment_button }}
                    </div>
                  {% endif %}
                {% endform %}
                <a class="btn secondary" href="{{ fp.url }}" style="margin-left: 8px;">{{ block.settings.view_label }}</a>
              </div>
              <img src="{{ fp.featured_image | image_url: width: 800 }}" alt="{{ fp.title | escape }}" style="width: 100%; border-radius: {{ block.settings.image_radius }}px;">
            {% else %}
              <img src="{{ fp.featured_image | image_url: width: 800 }}" alt="{{ fp.title | escape }}" style="width: 100%; border-radius: {{ block.settings.image_radius }}px;">
              <div>
                {% if block.settings.eyebrow != blank %}
                  <p style="margin: 0 0 6px; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; color: var(--muted);">{{ block.settings.eyebrow }}</p>
                {% endif %}
                <h2 style="margin: 0 0 8px; color: {{ block.settings.text_color }}; font-size: {{ block.settings.heading_size }}px;">{{ fp.title }}</h2>
                <p style="color: var(--price); font-weight: 700; font-size: 18px; margin: 0 0 12px;">{{ fp.price | money }}</p>
                {% if block.settings.show_description %}
                  <div style="color: {{ block.settings.text_color }}; margin-bottom: 16px;">{{ fp.description | strip_html | truncate: 200 }}</div>
                {% endif %}
                {% form 'product', fp %}
                  <input type="hidden" name="id" value="{{ fp.selected_or_first_available_variant.id }}">
                  <button class="btn" type="submit">{{ block.settings.btn_label }}</button>
                  {% if block.settings.show_shop_pay %}
                    <div style="margin-top: 10px;">
                      {{ form | payment_button }}
                    </div>
                  {% endif %}
                {% endform %}
                <a class="btn secondary" href="{{ fp.url }}" style="margin-left: 8px;">{{ block.settings.view_label }}</a>
              </div>
            {% endif %}
          </div>
        {% else %}
          <div style="margin-top: {{ block.settings.spacing_top }}px; padding: 16px; background: #f8faff; border: 1px dashed #c9d8fb; color: var(--muted); font-style: italic;" {{ block.shopify_attributes }}>
            Select a product in the 'Featured product' block settings to display it here.
          </div>
        {% endif %}

    {% endcase %}
  {% endfor %}

  {% if section.settings.show_page_content and page.content != blank %}
    <div class="rte" style="color: {{ section.settings.text_color }};">{{ page.content }}</div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Page content",
  "settings": [
    {
      "type": "header",
      "content": "Page title"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "text",
      "id": "page_heading",
      "label": "Override page title",
      "info": "Leave blank to use the page title set in Shopify admin → Online Store → Pages."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Title font size",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Title color",
      "default": "#0f172a"
    },
    {
      "type": "header",
      "content": "Intro paragraph"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro paragraph text",
      "info": "A short description shown below the title. Leave blank to hide."
    },
    {
      "type": "range",
      "id": "intro_size",
      "label": "Intro text font size",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Page body content"
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Show page body content",
      "default": true,
      "info": "Renders the rich-text content written in Shopify admin → Online Store → Pages."
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#334155"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Maximum content width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 980,
      "info": "Limits how wide this section can get on large screens."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (space above content)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (space below content)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 26
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading text",
          "default": "Section heading"
        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "Heading size",
          "min": 16,
          "max": 48,
          "step": 2,
          "unit": "px",
          "default": 22
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#0f172a"
        },
        {
          "type": "range",
          "id": "spacing_top",
          "label": "Space above this heading",
          "min": 0,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 24
        }
      ]
    },
    {
      "type": "text",
      "name": "Text block",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your content here. This text is fully editable from the Shopify theme editor.</p>"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#334155"
        },
        {
          "type": "range",
          "id": "text_size",
          "label": "Text size",
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "spacing_top",
          "label": "Space above this text block",
          "min": 0,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 12
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description (alt text)",
          "info": "Briefly describe the image. This helps with search engines and accessibility."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "Optional small text shown below the image."
        },
        {
          "type": "color",
          "id": "caption_color",
          "label": "Caption text color",
          "default": "#475569"
        },
        {
          "type": "range",
          "id": "max_width",
          "label": "Maximum image width",
          "min": 100,
          "max": 1200,
          "step": 50,
          "unit": "px",
          "default": 800
        },
        {
          "type": "range",
          "id": "border_radius",
          "label": "Image corner roundness",
          "min": 0,
          "max": 24,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "select",
          "id": "image_align",
          "label": "Image alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "spacing_top",
          "label": "Space above this image",
          "min": 0,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 16
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link",
          "info": "Where this button takes the customer when clicked."
        },
        {
          "type": "color",
          "id": "btn_bg_color",
          "label": "Button background color",
          "default": "#3b82f6"
        },
        {
          "type": "color",
          "id": "btn_text_color",
          "label": "Button text color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "button_align",
          "label": "Button alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "spacing_top",
          "label": "Space above this button",
          "min": 0,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 16
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider line",
      "settings": [
        {
          "type": "color",
          "id": "color",
          "label": "Line color",
          "default": "#dbe4ff"
        },
        {
          "type": "range",
          "id": "thickness",
          "label": "Line thickness",
          "min": 1,
          "max": 8,
          "step": 1,
          "unit": "px",
          "default": 1
        },
        {
          "type": "range",
          "id": "spacing",
          "label": "Space above and below line",
          "min": 4,
          "max": 60,
          "step": 4,
          "unit": "px",
          "default": 24
        }
      ]
    },
    {
      "type": "spacer",
      "name": "Spacer (blank space)",
      "settings": [
        {
          "type": "range",
          "id": "height",
          "label": "Height of blank space",
          "min": 8,
          "max": 120,
          "step": 4,
          "unit": "px",
          "default": 32
        }
      ]
    },
    {
      "type": "hero",
      "name": "Hero banner",
      "settings": [
        {
          "type": "paragraph",
          "content": "A full-width banner with a background image, heading, text, and buttons. Great for announcements or featured collections."
        },
        {
          "type": "header",
          "content": "Background"
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Background image",
          "info": "Used as the banner background. Leave blank to use a solid color instead."
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color",
          "default": "#0f172a",
          "info": "Shown when no image is set, or behind a transparent image."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Dark overlay opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "default": 40,
          "info": "Darkens the background image so text is easier to read. 0 = no overlay."
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "min_height",
          "label": "Banner minimum height",
          "min": 100,
          "max": 800,
          "step": 20,
          "unit": "px",
          "default": 340
        },
        {
          "type": "range",
          "id": "border_radius",
          "label": "Corner roundness",
          "min": 0,
          "max": 24,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text (small label above heading)",
