<header class="site-header">
  <a class="logo-link" href="{{ routes.root_url }}">
    {% if section.settings.logo_image != blank %}
      <img
        class="logo-img"
        src="{{ section.settings.logo_image | image_url: width: 400 }}"
        alt="{{ shop.name | escape }}"
        width="{{ section.settings.logo_height | times: 2 }}"
        height="{{ section.settings.logo_height }}"
        style="height: {{ section.settings.logo_height }}px; width: auto;"
      >
    {% else %}
      <span class="logo-text">{{ settings.logo_text | default: shop.name }}</span>
    {% endif %}
  </a>

  {% if section.settings.show_status and section.settings.status_text != blank %}
    <p class="site-header__status"><em>{{ section.settings.status_text }}</em></p>
  {% endif %}

  <div class="header-right">
    {% if section.settings.show_flag %}
      <div class="flag" title="USA">
        <svg viewBox="0 0 640 480" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill="#bd3d44" d="M0 0h640v480H0z"/>
          <path fill="#fff" d="M0 55.4h640v55.4H0zm0 110.8h640v55.4H0zm0 110.8h640v55.4H0zm0 110.8h640V448H0z"/>
          <path fill="#192f5d" d="M0 0h296v221.6H0z"/>
        </svg>
      </div>
    {% endif %}

    {% if section.settings.show_clock %}
      <div class="wii-clock-analog" aria-hidden="true">
        <svg id="wii-clock-face" width="104" height="104" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="47" fill="#ffffff" stroke="#8FAACA" stroke-width="3"/>
          <circle cx="50" cy="50" r="41" fill="none" stroke="#e2e8eb" stroke-width="1"/>
          <g id="wii-clock-numbers" font-family="'Times New Roman', Times, serif" font-weight="700" font-size="11.5" fill="#2063A2" text-anchor="middle"></g>
          <line id="wii-clock-hour" class="clock-hour" x1="50" y1="50" x2="50" y2="30" stroke="#B02E27" stroke-width="4.2" stroke-linecap="round"/>
          <line id="wii-clock-minute" class="clock-minute" x1="50" y1="50" x2="50" y2="19" stroke="#B02E27" stroke-width="2.8" stroke-linecap="round"/>
          <line id="wii-clock-second" class="clock-second" x1="50" y1="54" x2="50" y2="16" stroke="#B02E27" stroke-width="1.1" stroke-linecap="round" opacity=".65"/>
          <circle cx="50" cy="50" r="2.8" fill="#B02E27"/>
          <circle cx="50" cy="50" r="1.1" fill="#ffffff"/>
        </svg>
        <span class="wii-clock-date" id="wii-clock-date" style="color: {{ section.settings.clock_color }};"></span>
      </div>
    {% endif %}

    {% if section.settings.show_cart_button %}
      <a class="pill" href="{{ routes.cart_url }}">
        {{ section.settings.cart_label }}
        {% if cart.item_count > 0 %}({{ cart.item_count }}){% endif %}
      </a>
    {% endif %}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo_image", "label": "Logo image" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 32, "max": 120, "step": 2, "unit": "px", "default": 90 },
    { "type": "checkbox", "id": "show_clock", "label": "Show analog clock", "default": true },
    { "type": "color", "id": "clock_color", "label": "Clock date color", "info": "Colors the day/date line below the clock face.", "default": "#9AA5AA" },
    { "type": "checkbox", "id": "show_flag", "label": "Show USA flag", "default": true },
    { "type": "checkbox", "id": "show_cart_button", "label": "Show cart button", "default": true },
    { "type": "text", "id": "cart_label", "label": "Cart button label", "default": "Checkout" },
    { "type": "checkbox", "id": "show_status", "label": "Show status message", "default": true },
    { "type": "text", "id": "status_text", "label": "Status message", "default": "This website is always under construction." }
  ]
}
{% endschema %}
