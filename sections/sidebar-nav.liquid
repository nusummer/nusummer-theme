<aside>
  <nav class="panel sidebar-nav" aria-label="Sidebar">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <a class="pill" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {% endfor %}
    {% else %}
      <a class="pill" href="{{ routes.all_products_collection_url }}">Truckers n Shirts</a>
      <a class="pill" href="/products/5-alpha-dhp">Research Chemicals</a>
    {% endif %}
  </nav>

  {% if section.settings.show_status and section.settings.status_text != blank %}
    <div class="panel status-box"><h3><em>{{ section.settings.status_text }}</em></h3></div>
  {% endif %}
</aside>

{% schema %}
{
  "name": "Sidebar navigation",
  "settings": [
    { "type": "checkbox", "id": "show_status", "label": "Show status box", "default": true },
    { "type": "text", "id": "status_text", "label": "Status text", "default": "This website is always under construction." }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Link" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sidebar navigation",
      "blocks": [
        { "type": "nav_link", "settings": { "label": "Truckers n Shirts", "url": "/collections/all" } },
        { "type": "nav_link", "settings": { "label": "Research Chemicals", "url": "/products/5-alpha-dhp" } }
      ]
    }
  ]
}
{% endschema %}
