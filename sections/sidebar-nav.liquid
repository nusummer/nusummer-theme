<aside style="background: {{ section.settings.aside_bg_color }};">
  <nav class="menu panel sidebar-nav" style="background: {{ section.settings.nav_bg_color }};">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        <a
          class="sidebar-link"
          href="{{ block.settings.url }}"
          style="color: {{ section.settings.link_color }};"
          {{ block.shopify_attributes }}
        >
          <span>{{ block.settings.label }}</span>
        </a>
      {% endfor %}
    {% else %}
      <a class="sidebar-link" href="{{ routes.root_url }}" style="color: {{ section.settings.link_color }};"><span>Home</span></a>
      <a class="sidebar-link" href="/pages/about" style="color: {{ section.settings.link_color }};"><span>About</span></a>
      <a class="sidebar-link" href="/pages/contact" style="color: {{ section.settings.link_color }};"><span>Contact</span></a>
    {% endif %}
  </nav>

  {% if section.settings.show_status %}
    <div class="panel status-box" style="background: {{ section.settings.status_bg_color }}; color: {{ section.settings.status_text_color }};">
      <h3><em>{{ section.settings.status_text | default: settings.status_text }}</em></h3>
    </div>
  {% endif %}
</aside>

{% schema %}
{
  "name": "Sidebar navigation",
  "settings": [
    {
      "type": "header",
      "content": "Navigation links",
      "info": "Use the + Add block button below to add, remove, or reorder your sidebar links."
    },
    {
      "type": "header",
      "content": "Sidebar background"
    },
    {
      "type": "color",
      "id": "aside_bg_color",
      "label": "Outer sidebar background color",
      "default": "#f6f9ff",
      "info": "The background color behind the whole sidebar column."
    },
    {
      "type": "color",
      "id": "nav_bg_color",
      "label": "Nav panel background color",
      "default": "#ffffff",
      "info": "The background color of the navigation links panel."
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link text color",
      "default": "#2563eb"
    },
    {
      "type": "header",
      "content": "Status message box"
    },
    {
      "type": "checkbox",
      "id": "show_status",
      "label": "Show status message box",
      "default": true
    },
    {
      "type": "text",
      "id": "status_text",
      "label": "Status message",
      "info": "Leave blank to use the global status message from Theme Settings → Brand."
    },
    {
      "type": "color",
      "id": "status_bg_color",
      "label": "Status box background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "status_text_color",
      "label": "Status message text color",
      "default": "#0f172a"
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "New link",
          "info": "The text that appears on the link button."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL",
          "info": "Where this link goes when clicked. You can link to a collection, page, product, or external URL."
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Sidebar navigation",
      "blocks": [
        { "type": "nav_link", "settings": { "label": "Home", "url": "/" } },
        { "type": "nav_link", "settings": { "label": "About", "url": "/pages/about" } },
        { "type": "nav_link", "settings": { "label": "Contact", "url": "/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
