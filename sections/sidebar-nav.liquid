<aside>
  <nav class="panel sidebar-nav" aria-label="Sidebar">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.settings.shape == 'benzene' %}
          {% render 'nav-benzene', label: block.settings.label, url: block.settings.url %}
        {% else %}
          <a class="pill nav-btn" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <img class="nav-hat-img" src="{{ block.settings.image | image_url: width: 128 }}" alt="" width="64" height="64" loading="lazy">
            {% endif %}
            <span>{{ block.settings.label }}</span>
          </a>
        {% endif %}
      {% endfor %}
    {% else %}
      {% comment %}
        This store has never had blocks added to this section (no settings_data.json
        ships in this repo, so block data lives only in Shopify's DB and starts empty).
        This fallback is what's actually rendering live — it must be visually complete,
        not a simplified stand-in, so Research Chemicals renders via the same benzene
        snippet used by the block path.
      {% endcomment %}
      <a class="pill nav-btn" href="/products/as-seen-on-tv-trucker-hat">
        <img class="nav-hat-img" src="{{ 'hat-button.png' | asset_url }}" alt="" width="64" height="64" loading="lazy">
        <span>Buy Now</span>
      </a>
      {% render 'nav-benzene', label: 'Research Chemicals', url: '/products/5-alpha-dhp' %}
    {% endif %}
  </nav>
</aside>

{% schema %}
{
  "name": "Sidebar navigation",
  "settings": [],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Link" },
        { "type": "url", "id": "url", "label": "URL" },
        { "type": "image_picker", "id": "image", "label": "Icon image", "info": "Optional small icon/photo shown to the left of the label." },
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "info": "Only applies once you've added blocks here via \"Add block\" below — until then, this section shows its two built-in default links.",
          "options": [
            { "value": "pill", "label": "Pill" },
            { "value": "benzene", "label": "Benzene ring" }
          ],
          "default": "pill"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sidebar navigation",
      "blocks": [
        { "type": "nav_link", "settings": { "label": "Buy Now", "url": "/products/as-seen-on-tv-trucker-hat", "shape": "pill" } },
        { "type": "nav_link", "settings": { "label": "Research Chemicals", "url": "/products/5-alpha-dhp", "shape": "benzene" } }
      ]
    }
  ]
}
{% endschema %}
