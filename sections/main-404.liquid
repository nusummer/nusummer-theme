<section class="panel" style="text-align: center;">
  <h1 class="section-heading" style="border: 0;">{{ section.settings.heading }}</h1>
  <p>{{ section.settings.message }}</p>
  <a class="btn" href="{{ routes.root_url }}">{{ section.settings.back_label }}</a>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found" },
    { "type": "text", "id": "message", "label": "Message", "default": "The page you were looking for does not exist." },
    { "type": "text", "id": "back_label", "label": "Back button label", "default": "Back to home" }
  ]
}
{% endschema %}
