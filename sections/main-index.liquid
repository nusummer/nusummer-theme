<section class="panel section-wrap">
  {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="product-grid">
    {% assign featured_collection = collections[section.settings.collection] %}
    {% if featured_collection and featured_collection.products_count > 0 %}
      {% for product in featured_collection.products limit: section.settings.products_limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    {% else %}
      <article class="card">
        <div class="card-media"></div>
        <h3 class="card-title">{{ section.settings.empty_title }}</h3>
        <div class="card-body">{{ section.settings.empty_message }}</div>
      </article>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Home — featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": ":: Welcome"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to feature",
      "info": "Defaults to the built-in Frontpage collection if left blank."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Empty state"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Placeholder card title",
      "default": "Create products in Shopify"
    },
    {
      "type": "textarea",
      "id": "empty_message",
      "label": "Placeholder card message",
      "default": "Then add them to the Frontpage collection to populate this home section."
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
