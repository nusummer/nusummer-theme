<section class="panel">
  {% if section.settings.heading != blank %}
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  {% assign featured = collections[section.settings.collection] %}
  {% if featured != blank and featured.products_count > 0 %}
    <div class="product-grid">
      {% for product in featured.products limit: section.settings.products_limit %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
    {% if section.settings.show_view_all %}
      <div style="text-align: center; margin-top: 24px;">
        <a class="btn" href="{{ featured.url }}">{{ section.settings.view_all_label }}</a>
      </div>
    {% endif %}
  {% else %}
    <p class="small">{{ section.settings.empty_message }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view-all button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "View all" },
    { "type": "text", "id": "empty_message", "label": "Empty state message", "default": "Select a collection for this section in the theme editor." }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
