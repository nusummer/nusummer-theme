<section class="panel">
  <div class="product-detail">
    <div class="product-detail__media">
      {% assign images = product.images %}
      {% if images.size > 1 %}
        <div class="product-gallery" data-product-gallery>
          <div class="product-gallery__stage">
            <button type="button" class="product-gallery__arrow product-gallery__arrow--prev" data-gallery-prev aria-label="Previous photo">‹</button>
            <div class="product-gallery__main">
              {% for image in images %}
                <img
                  src="{{ image | image_url: width: 900 }}"
                  srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 640px) 100vw, 450px"
                  alt="{{ image.alt | default: product.title | escape }}"
                  width="900"
                  height="900"
                  class="product-gallery__slide{% if forloop.first %} is-active{% endif %}"
                  data-gallery-slide
                  data-image-id="{{ image.id }}"
                  {% unless forloop.first %}hidden{% endunless %}
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              {% endfor %}
            </div>
            <button type="button" class="product-gallery__arrow product-gallery__arrow--next" data-gallery-next aria-label="Next photo">›</button>
          </div>
          <div class="product-gallery__thumbs" role="tablist" aria-label="Product photos">
            {% for image in images %}
              <button
                type="button"
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb
                data-image-id="{{ image.id }}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="Show photo {{ forloop.index }} of {{ forloop.length }}"
              >
                <img src="{{ image | image_url: width: 160 }}" alt="" width="72" height="72" loading="lazy">
              </button>
            {% endfor %}
          </div>
        </div>
      {% elsif product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 900 }}"
          alt="{{ product.featured_image.alt | escape }}"
          width="900"
          height="900"
        >
      {% endif %}
    </div>

    <div class="product-detail__info">
      {% if section.settings.show_vendor and product.vendor != blank %}
        <p class="product-detail__vendor">{{ product.vendor }}</p>
      {% endif %}

      <h1 class="product-detail__title">{{ product.title }}</h1>

      <div class="product-detail__price">
        <span id="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <s>{{ product.compare_at_price | money }}</s>
        {% endif %}
      </div>

      {% if product.description != blank %}
        <div class="product-detail__description">{{ product.description }}</div>
      {% endif %}

      {% form 'product', product %}
        {% if product.variants.size > 1 %}
          <label class="visually-hidden" for="variant-select">Variant</label>
          <select class="variant-select" id="variant-select" name="id">
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                data-image-id="{{ variant.featured_image.id }}"
                {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (sold out){% endunless %}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {% endif %}

        <label class="visually-hidden" for="qty">Quantity</label>
        <input class="qty-input" id="qty" type="number" name="quantity" min="1" value="1">

        <div>
          {% if product.available %}
            <button class="btn" type="submit">{{ section.settings.add_label }}</button>
          {% else %}
            <button class="btn secondary" type="button" disabled>Sold out</button>
          {% endif %}
          {% if section.settings.show_payment_button %}
            {{ form | payment_button }}
          {% endif %}
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "checkbox", "id": "show_payment_button", "label": "Show dynamic checkout button", "default": true }
  ]
}
{% endschema %}
