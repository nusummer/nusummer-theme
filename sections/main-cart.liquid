<section class="panel section-wrap">
  <h1>{{ section.settings.heading }}</h1>
  {% if cart.item_count == 0 %}
    <p>{{ section.settings.empty_message }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ section.settings.continue_shopping_label }}</a>
  {% else %}
    {% form 'cart', cart %}
      <table class="cart-table">
        <thead>
          <tr>
            <th>{{ section.settings.col_product }}</th>
            <th>{{ section.settings.col_quantity }}</th>
            <th>{{ section.settings.col_price }}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <br><small>{{ item.variant.title }}</small>
                {% endunless %}
              </td>
              <td>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0">
              </td>
              <td>{{ item.line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="cart-footer">
        <p><strong>{{ section.settings.total_label }}: {{ cart.total_price | money }}</strong></p>
        <button class="btn secondary" type="submit" name="update">{{ section.settings.update_label }}</button>
        <button class="btn" type="submit" name="checkout">{{ section.settings.checkout_label }}</button>
      </div>
    {% endform %}
  {% endif %}
</section>
{% schema %}
{
  "name": "Cart page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Your cart"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty cart message",
      "default": "Your cart is empty."
    },
    {
      "type": "text",
      "id": "continue_shopping_label",
      "label": "Continue shopping button label",
      "default": "Continue shopping"
    },
    {
      "type": "header",
      "content": "Table labels"
    },
    {
      "type": "text",
      "id": "col_product",
      "label": "Product column heading",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "col_quantity",
      "label": "Quantity column heading",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "col_price",
      "label": "Price column heading",
      "default": "Price"
    },
    {
      "type": "header",
      "content": "Footer labels"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "update_label",
      "label": "Update cart button label",
      "default": "Update cart"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Checkout"
    }
  ],
  "presets": [
    {
      "name": "Cart page"
    }
  ]
}
{% endschema %}
