<section class="panel">
  <h1 class="section-heading">{{ section.settings.heading }}</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      <table class="cart-table">
        <thead>
          <tr><th colspan="2">Item</th><th>Price</th><th>Qty</th><th>Total</th><th></th></tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 128 }}" alt="{{ item.image.alt | escape }}" width="64" height="64">
                {% endif %}
              </td>
              <td><a href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}<div class="small">{{ item.variant.title }}</div>{% endunless %}
              </td>
              <td>{{ item.price | money }}</td>
              <td>
                <label class="visually-hidden" for="updates_{{ item.key }}">Quantity</label>
                <input class="qty-input" id="updates_{{ item.key }}" type="number" name="updates[]" min="0" value="{{ item.quantity }}">
              </td>
              <td>{{ item.final_line_price | money }}</td>
              <td><a class="small" href="{{ item.url_to_remove }}">Remove</a></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="cart-footer">
        <span class="cart-total">{{ cart.total_price | money }}</span>
        <button class="btn secondary" type="submit" name="update">Update</button>
        <button class="btn" type="submit" name="checkout">{{ section.settings.checkout_label }}</button>
      </div>
    </form>
  {% else %}
    <p>{{ section.settings.empty_message }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ section.settings.continue_label }}</a>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "text", "id": "empty_message", "label": "Empty cart message", "default": "Your cart is empty." },
    { "type": "text", "id": "continue_label", "label": "Continue shopping label", "default": "Continue shopping" },
    { "type": "text", "id": "checkout_label", "label": "Checkout label", "default": "Check out" }
  ]
}
{% endschema %}
