<section
  class="panel section-wrap"
  style="
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <h1 style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h1>

  {% if cart.item_count == 0 %}
    <p>{{ section.settings.empty_message }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ section.settings.continue_shopping_label }}</a>

  {% else %}
    {% form 'cart', cart %}
      <table class="cart-table">
        <thead>
          <tr>
            <th>{{ section.settings.col_product }}</th>
            <th>{{ section.settings.col_quantity }}</th>
            <th>{{ section.settings.col_price }}</th>
          </tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>
                {% if section.settings.show_product_images %}
                  <img
                    src="{{ item.image | image_url: width: 80 }}"
                    alt="{{ item.title | escape }}"
                    style="width: 60px; height: 60px; object-fit: cover; margin-right: 10px; vertical-align: middle; border-radius: 4px;"
                  >
                {% endif %}
                <a href="{{ item.url }}" style="color: {{ section.settings.link_color }};">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}
                  <br><small style="color: {{ section.settings.text_color }};">{{ item.variant.title }}</small>
                {% endunless %}
              </td>
              <td>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width: 60px; padding: 4px 8px;">
              </td>
              <td style="color: {{ section.settings.price_color }}; font-weight: 700;">
                {{ item.line_price | money }}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div class="cart-footer">
        <p style="font-weight: 700;">
          {{ section.settings.total_label }}: <span style="color: {{ section.settings.price_color }};">{{ cart.total_price | money }}</span>
        </p>
        {% if section.settings.show_note_field %}
          <div style="margin-bottom: 12px;">
            <label for="cart-note" style="font-weight: 700; display: block; margin-bottom: 4px;">{{ section.settings.note_label }}</label>
            <textarea id="cart-note" name="note" rows="3" style="width: 100%; padding: 8px; border: 1px solid #ccc;">{{ cart.note }}</textarea>
          </div>
        {% endif %}
        <button class="btn secondary" type="submit" name="update">{{ section.settings.update_label }}</button>
        <button class="btn" type="submit" name="checkout">{{ section.settings.checkout_label }}</button>
      </div>
    {% endform %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart page",
  "settings": [
    {
      "type": "header",
      "content": "Text labels"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Your cart"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Message when cart is empty",
      "default": "Your cart is empty."
    },
    {
      "type": "text",
      "id": "continue_shopping_label",
      "label": "Continue shopping button label",
      "default": "Continue shopping"
    },
    {
      "type": "header",
      "content": "Table column headings"
    },
    {
      "type": "text",
      "id": "col_product",
      "label": "Product column heading",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "col_quantity",
      "label": "Quantity column heading",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "col_price",
      "label": "Price column heading",
      "default": "Price"
    },
    {
      "type": "header",
      "content": "Cart totals & buttons"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "update_label",
      "label": "Update cart button label",
      "default": "Update cart"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Checkout"
    },
    {
      "type": "header",
      "content": "Extra options"
    },
    {
      "type": "checkbox",
      "id": "show_product_images",
      "label": "Show product images in cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_note_field",
      "label": "Show order notes field",
      "default": false,
      "info": "Lets customers leave a note with their order."
    },
    {
      "type": "text",
      "id": "note_label",
      "label": "Order notes label",
      "default": "Order notes"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#b91c1c"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Product link color",
      "default": "#2063A2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (space above content)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (space below content)",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 26
    }
  ],
  "presets": [
    {
      "name": "Cart page"
    }
  ]
}
{% endschema %}
