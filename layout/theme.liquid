<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% if page_title %}{{ page_title }} | {% endif %}{{ shop.name }}</title>
  <meta name="description" content="{{ page_description | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {{ content_for_header }}
  <style>
    :root {
      --accent: {{ settings.accent_blue }};
      --red: {{ settings.accent_red }};
      --shadow-1: {{ settings.shadow_1 }};
      --shadow-2: {{ settings.shadow_2 }};
      --bg: {{ settings.color_bg }};
      --text: {{ settings.color_text }};
      --wrap: {{ settings.page_width }}px;
      --sidebar: {{ settings.sidebar_width }}px;
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body data-sounds="{{ settings.enable_sounds }}" data-haptics="{{ settings.enable_haptics }}">
  <div class="page-width">
    {% section 'site-header' %}
    <div class="main-grid{% unless settings.show_sidebar %} no-sidebar{% endunless %}">
      {% if settings.show_sidebar %}
        {% section 'sidebar-nav' %}
      {% endif %}
      <main id="main">{{ content_for_layout }}</main>
    </div>
  </div>
  {% section 'site-footer' %}
</body>
</html>
